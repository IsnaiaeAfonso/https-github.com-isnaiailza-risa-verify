# AWS S3 + KMS (server-side only)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=iasx
AWS_KMS_KEY_ID=

# Optional application settings
RISA_DOMAIN=risaverify.com.br
NEXT_PUBLIC_APP_NAME=IASX Clinical Review
NEXT_PUBLIC_APP_URL=http://192.168.15.13:3100
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Patient upload security and routing
PATIENT_UPLOAD_IDENTITY_SECRET=replace-with-a-long-random-secret
PATIENT_UPLOAD_DOCTOR_NAMES=Dra. Laura Santos,Dr. Rafael Neto,Dr. Gustavo Medeiros,Dr. Omar Faria,Dr. Caio Mendes,Dr. Vinícius Prado,Dr. Fernando Costa,Dr. Theo Santos,Dr. Ana Rocha,Dr. Camila Lopes

# Private hosted portal. Use a unique password generated by a password manager.
PORTAL_ACCESS_PASSWORD=replace-with-a-unique-long-password

# RISA retention policy (empty means do not persist; do not invent a duration)
NEXT_PUBLIC_RISA_AUDIO_RETENTION_POLICY=O IASX não cria nem armazena arquivos de áudio nesta versão.
NEXT_PUBLIC_RISA_TRANSCRIPT_RETENTION_POLICY=Transcrição mantida apenas em memória até descartar a sessão ou fechar/recarregar a página.
